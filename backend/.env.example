# OpenAI 兼容网关（问答生成）
# ---------- 讯飞星火 Lite（HTTP，与 ai-03-writemd 一致）----------
# 【重要】HTTP 兼容接口的 Authorization 必须是控制台「HTTP 服务接口认证」里的 **APIPassword**（单列）。
# 若把 WebSocket 用的 APPID:APISecret 填进 OPENAI_API_KEY，常见报错：401 / apikey not found / HMAC。
# 推荐单独一行（可与 writemd 共用变量名，本仓库会优先读取）：
SPARK_HTTP_API_PASSWORD=
# 备选别名：
# XFYUN_HTTP_API_PASSWORD=

# 仍兼容：仅填 APIPassword 到 OPENAI_API_KEY（不要加 Bearer 前缀，不要带引号）
OPENAI_API_KEY=
# 留空且走星火网关时，会自动使用：https://spark-api-open.xf-yun.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=lite
# 可选：星火请求体 user 字段（文档示例中的用户 id）
# SPARK_CHAT_USER=ai-05-knowledge-rag

# ---------- 若使用 OpenAI 官方或其它兼容网关，可改为 ----------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

BACKEND_PORT=8905
BACKEND_HOST=127.0.0.1

# 向量与切块（可选覆盖）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=vector_db/chroma
RAG_TOP_K=5
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=80
