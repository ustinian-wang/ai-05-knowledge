# OpenAI 兼容网关（问答生成）
# ---------- 讯飞星火 Lite（HTTP，与 ai-03-writemd 一致）----------
# 密钥常为 APPID:APISecret（控制台「HTTP 服务接口认证」以实际说明为准，也可能是单列 APIPassword）
OPENAI_API_KEY=
# 留空且密钥形如 xxx:yyy 或 OPENAI_MODEL=lite 时，会自动使用星火网关：
#   https://spark-api-open.xf-yun.com/v1
OPENAI_BASE_URL=
# Lite 填 lite；也可填 generalv3.5 等（以控制台为准）
OPENAI_MODEL=lite

# ---------- 若使用 OpenAI 官方或其它兼容网关，可改为 ----------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

BACKEND_PORT=8905
BACKEND_HOST=127.0.0.1

# 向量与切块（可选覆盖）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=vector_db/chroma
RAG_TOP_K=5
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=80
